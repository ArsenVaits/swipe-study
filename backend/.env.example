# Copy to .env and fill in. Never commit .env. All values are server-only.

PORT=3001
# Comma-separated frontend origins allowed by CORS ("*" for any)
CORS_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/scrolled.db

# --- Lesson generation (Claude Opus) ---
ANTHROPIC_API_KEY=
OPUS_MODEL=claude-opus-5-5
# low | medium | high  (medium = good speed/quality balance for the demo)
OPUS_EFFORT=medium
# true: Opus calls the start_video_generation tool; false: backend starts video from lesson.scenePrompt
OPUS_TOOL_CALLING=true

# --- Video: mock (default) | ltx | hyperframes ---
VIDEO_PROVIDER=mock
# Put the demo clip at backend/public/demo/lesson.mp4, or use any absolute https URL
MOCK_VIDEO_URL=/demo/lesson.mp4
# Fake "render time" for the mock, ms
MOCK_VIDEO_DELAY_MS=8000
# Required only when VIDEO_PROVIDER=ltx
LTX_API_KEY=

# --- HyperFrames (VIDEO_PROVIDER=hyperframes): Opus writes an animated HTML+GSAP explainer, rendered to MP4 ---
# Needs FFmpeg on PATH and Chrome (system Chrome, or `npx hyperframes browser`). Check with: npx hyperframes doctor
# Uses ANTHROPIC_API_KEY above. Without it every video uses the built-in fallback template.
HYPERFRAMES_MODEL=claude-opus-5-5
HYPERFRAMES_EFFORT=low
# Effort for fix rounds and the visual review (targeted edits)
HYPERFRAMES_FIX_EFFORT=low
HYPERFRAMES_FPS=30
# draft | standard | high
HYPERFRAMES_QUALITY=standard
# Renders are CPU-heavy; raise on big machines
HYPERFRAMES_MAX_PARALLEL_RENDERS=1
# Chrome capture workers per render (~256 MB RAM each); 12 was the sweet spot on a 20-core server
HYPERFRAMES_RENDER_WORKERS=12
HYPERFRAMES_RENDER_TIMEOUT_MS=600000
# After the checks the model reviews phone-size frames of its own render and may revise once (+~$0.05, +~30 s)
HYPERFRAMES_REVIEW=true
# Burned-in subtitles of the narration (off: the frontend shows captions itself)
HYPERFRAMES_CAPTIONS=false
# 0..2 rounds where Opus fixes what `hyperframes check` found
HYPERFRAMES_FIX_ROUNDS=2
# true keeps data/hyperframes/<job>/ (index.html, logs) after a successful render, for debugging
HYPERFRAMES_KEEP_WORK_DIRS=false
# Default: folders "hyperframes" and "videos" next to DATABASE_PATH
HYPERFRAMES_WORK_DIR=
VIDEO_OUTPUT_DIR=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Voiceover for HyperFrames videos: none | openai | elevenlabs | piper (none = silent video)
TTS_PROVIDER=none
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Piper: free local TTS. pip install piper-tts==1.8.0; voices: huggingface.co/rhasspy/piper-voices
# (ru_RU dmitri / denis are CC0). PIPER_MODEL is the absolute path to the .onnx (its .onnx.json next to it).
PIPER_BIN=piper
PIPER_MODEL=
# Optional English override. Default: <database directory>/piper/en_US-ljspeech-high.onnx if installed.
PIPER_ENGLISH_MODEL=
# < 1 speaks faster
PIPER_LENGTH_SCALE=0.95

# --- Lesson series (POST /api/lesson-sets): the planner picks 1..MAX_LESSONS_PER_SET lessons ---
MAX_SET_SOURCE_CHARS=300000
MAX_LESSONS_PER_SET=10
PLAN_MODEL=claude-haiku-5-5
# Every video runs between these lengths (short voiceovers get a longer final hold)
VIDEO_MIN_SECONDS=35
VIDEO_MAX_SECONDS=60
# Concurrent composition conversations (a series starts several lessons at once)
HYPERFRAMES_MAX_PARALLEL_COMPOSE=3

# --- Limits ---
MAX_SOURCE_CHARS=12000
MAX_LESSON_JOBS_PER_SESSION=20
MAX_VIDEO_JOBS_PER_SESSION=5
# Total paid renders (LTX / HyperFrames) the server will ever start (protects the demo budget)
MAX_VIDEO_JOBS_TOTAL=50
